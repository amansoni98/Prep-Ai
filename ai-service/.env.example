# Provider priority (comma separated). Providers without config are skipped.
LLM_PROVIDERS=groq,ollama

# Groq (primary)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local fallback) - run `ollama pull mistral` first
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Optional shared secret; if set, the backend must send it as x-service-key
AI_SERVICE_KEY=
